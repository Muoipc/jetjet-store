# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=jetjet_store

# Security & Session
SESSION_SECRET=your_secret_session_key_random_64_chars
ADMIN_KEY=your_admin_secret_password

# Casso Webhook Payment Integration
CASSO_SECURE_TOKEN=your_casso_secure_token

# Email OTP & Order Confirmation (Optional - prints to console if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
